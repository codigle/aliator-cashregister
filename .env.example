# Local development example only; never commit the actual .env.
DB_PASSWORD=SET_A_STRONG_LOCAL_PASSWORD
STAFF_TOKEN=GENERATE_A_PRIVATE_STAFF_TOKEN
DEMO_OWNER_PASSWORD=SET_A_UNIQUE_LONG_DEMO_PASSWORD
OWNER_INVITE_CODE=SET_A_PRIVATE_INVITE_CODE
REGISTRATION_SMTP_HOST=smtp.example.com
REGISTRATION_SMTP_USER=demo@example.com
REGISTRATION_SMTP_PASSWORD_B64=BASE64_OF_PRIVATE_MAIL_PASSWORD
REGISTRATION_FROM=demo@example.com
REGISTRATION_OTP_SECRET=GENERATE_A_RANDOM_OTP_SECRET
PUBLIC_BASE_URL=http://localhost:18761
CASHREGISTER_V9_SEED_TEST=false
CASHREGISTER_TEST_SEED_EMAIL=
# Optional existing translator adapter; must not expose tokens to browser.
CODIGLE_TRANSLATION_URL=
CODIGLE_TRANSLATION_TOKEN=

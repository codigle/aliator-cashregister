# Raspberry Pi local-only config EXAMPLES. Never commit real tokens.
# /etc/aliator-print-agent.env
ALIATOR_USB_DEVICE=/dev/usb/lp0
ALIATOR_SPOOL=/var/lib/aliator-print-agent
ALIATOR_LABEL_WIDTH_MM=58
ALIATOR_LABEL_HEIGHT_MM=60
ALIATOR_LABEL_GAP_MM=0
# /etc/aliator-print-bridge.env
ALIATOR_PRINT_SERVER=https://cashregister.aliator.com
ALIATOR_PRINT_TOKEN=REPLACE_WITH_PRIVATE_PRINTER_TOKEN
